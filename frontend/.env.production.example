# ==========================================================
# VARIABLES DEL FRONTEND PARA PRODUCCIÓN (Vercel)
# ==========================================================
# Copia este archivo a `.env.production` (o define las variables
# directamente en el dashboard de Vercel: Settings -> Environment
# Variables) y reemplaza con la URL REAL del backend en Render.
#
#   VITE_API_URL=https://pixel-store-api.onrender.com/api
#
# Importante:
#  - Debe terminar en /api (así lo esperan los Services del frontend).
#  - NO uses http://127.0.0.1:8000 en producción: apuntaría al
#    contenedor del frontend, no al backend.
#  - Si usas .env.production, Vite lo toma automáticamente al hacer
#    `npm run build`. En Vercel, definirla en el dashboard basta.
# ==========================================================

VITE_API_URL=https://pixel-store-api.onrender.com/api
